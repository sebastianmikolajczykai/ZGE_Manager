DB_PATH=dane/zge.db
PORT=3000
HOST=127.0.0.1
# Codzienna kopia bazy: wpisz folder na innym dysku albo w OneDrive, np.
# BACKUP_DIR=C:\Users\NazwaUzytkownika\OneDrive\ZGE kopie
BACKUP_DIR=dane/kopie
# Ile ostatnich kopii trzymać (starsze są usuwane automatycznie)
BACKUP_KEEP=30
# Kalendarz Google (opcjonalnie, instrukcja w README → „Kalendarz Google”).
# Klucze klienta OAuth typu „Desktop app” z Google Cloud. Bez nich synchronizacja jest niedostępna, reszta działa.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Plik z tokenem konta Google po połączeniu (domyślnie w folderze dane, który nie trafia do repozytorium)
# GOOGLE_TOKEN_FILE=dane/google-token.json
